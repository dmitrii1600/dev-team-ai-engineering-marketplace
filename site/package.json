{
  "name": "catalog-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Catalog website (React single-page app) for the dev-team-ai-engineering-marketplace, published on GitHub Pages.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "check": "node scripts/build-catalog.mjs --check",
    "dev": "node scripts/build-catalog.mjs && vite",
    "build": "node scripts/build-catalog.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test \"tests/*.test.mjs\"",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
