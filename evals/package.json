{
  "name": "@dev-team/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eval harness for the plugins in this marketplace (skills, subagents, workflow). vitest + Claude Agent SDK, on the Claude Code subscription by default.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "eval": "vitest run",
    "eval:skills": "vitest run -t skill:",
    "eval:agents": "vitest run -t agent:",
    "eval:workflow": "vitest run -t workflow:",
    "eval:list": "vitest list",
    "eval:quality": "tsx src/skill-quality.ts",
    "eval:compare": "tsx src/compare.ts",
    "eval:repeat": "tsx src/repeat.ts",
    "eval:delta": "tsx src/delta.ts",
    "eval:benchmark": "tsx src/records/benchmark.ts",
    "eval:scaffold": "tsx src/scaffold.ts",
    "proxy:up": "bash scripts/litellm-proxy.sh up",
    "proxy:down": "bash scripts/litellm-proxy.sh down",
    "proxy:wait": "bash scripts/litellm-proxy.sh wait",
    "test:unit": "vitest run evals/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
