# Normalize line endings in the repo; hooks run through Git Bash on Windows
# and CRLF breaks shell scripts.
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
